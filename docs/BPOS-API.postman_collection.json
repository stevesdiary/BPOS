          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/tenants",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"Adaeze Beauty Store\",\n  \"ownerEmail\": \"adaeze@example.com\",\n  \"ownerPassword\": \"securePassword123\",\n  \"ownerFirstName\": \"Adaeze\",\n  "ownerLastName\": \"Okoro\"\n}"
            },
            "description": "Provision a new merchant tenant. Creates the tenant schema, owner user, and starter plan subscription. Unauthenticated."
          },
          "response": []
        }
      ]
    },
