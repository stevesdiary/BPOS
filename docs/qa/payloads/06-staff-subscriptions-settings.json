  "_query_examples": {
    "settings_audit_all": "?page=1&limit=50",
    "settings_audit_support_only": "?actorType=platform",
    "settings_audit_by_action": "?action=order.confirm&limit=10",
    "settings_audit_bad_actor_type": "?actorType=robot   (expect 400)"
  },
  "_uploads": {
    "endpoint": "POST /v1/uploads/image  (multipart/form-data, field name: file)",
    "allowed": ["image/jpeg", "image/png", "image/webp"],
    "rejected": ["image/gif", "application/pdf", "image/svg+xml"],
    "size_cap": "MAX_UPLOAD_SIZE_BYTES (default 10485760 = 10 MiB) — over the cap is 400 VALIDATION_ERROR, not 413",
    "curl_ok": "curl -sS -X POST $BASE/v1/uploads/image -H \"authorization: Bearer $TOKEN\" -F 'file=@fixtures/product.jpg'",
    "curl_wrong_type": "curl -sS -X POST $BASE/v1/uploads/image -H \"authorization: Bearer $TOKEN\" -F 'file=@fixtures/doc.pdf'",
    "curl_no_file": "curl -sS -X POST $BASE/v1/uploads/image -H \"authorization: Bearer $TOKEN\" -F 'notafile=x'"
  }
}
